meta {
    name = "Scape";
    description = "Personal Loot Filter, by Pumpkin Py";
}

apply(name : "*") {
    fontType = 1;
    textAccent = 1;
}

// var: item value thresholds
#define VALUE_TIER_S 10000000 // 10m
#define VALUE_TIER_A 5000000  // 5m
#define VALUE_TIER_B 1000000  // 1m
#define VALUE_TIER_C 100000   // 100k
#define VALUE_TIER_D 10000    // 10k

#define BROWN "ffD2B287"
#define LIGHT_BROWN "ffAF6025"
#define LIGHT_BROWN40 "66AF6025"
#define CARAMEL "ffF99619"
#define GOLD65 "A6D59F00"
#define GOLD "ffD59F00"
#define BURGUNDY "ff350D0D"
#define DARK_GREEN "ff09600D"
#define KHAKI "ffBEB287"
#define KHAKI65 "A6BEB287"
#define GRIMY_BROWN "ffb97435"
#define MASTER_RED "ffbd1400"

#define WHITE70 "b3ffffff"
#define WHITE15 "26ffffff"
#define BLUE "ff66b2ff"
#define BLUE60 "9966b2ff"
#define BLUE15 "2666b2ff"
#define GREEN "ff45dc32"
#define GREEN60 "9945dc32"
#define GREEN40 "6645dc32"
#define GREEN15 "2645dc32"
#define ORANGE "ffff9600"
#define PURPLE "ffaf00ff"
#define PURPLE65 "A6af00ff"
#define PURPLE40 "66af00ff"
#define PURPLE15 "26af00ff"
#define PINK "fff14bbd"
#define PINK60 "99f14bbd"
#define PINK40 "66f14bbd"
#define PINK15 "26f14bbd"
#define DARK_RED "ffc30000"
#define DARK_RED60 "99c30000"
#define DARK_RED40 "66c30000"
#define DARK_RED15 "26c30000"
#define CHARCOAL "ff424242"
#define LIGHT_GRAY "fff3f3f3"
#define LIGHT_GRAY20 "33f3f3f3"

#define COLOR_FG(_fg) \
    textColor = _fg;  \
    borderColor = _fg;
#define COLOR_FG_BG(_fg, _bg) \
    textColor = _fg;          \
    borderColor = _fg;        \
    backgroundColor = _bg;    \
    lootBeamColor = _bg;      \
    menuTextColor = _bg;
#define COLOR_FG_BG_TXT(_fg, _bg, _txt) \
    textColor = _txt;                   \
    borderColor = _fg;                  \
    backgroundColor = _bg;              \
    lootBeamColor = _fg;                \
    menuTextColor = _fg;
#define CLUE_COLOR(_fg, _bg) \
    textColor = _fg;         \
    borderColor = _fg;       \
    backgroundColor = _bg;   \
    showDespawn = true;      \
    showLootbeam = true;
#define DARK_BG(_name, _color)   \
    if (name : _name) {          \
        color = _color;          \
        borderColor = _color;    \
        backgroundColor = BLACK; \
    }
#define TEXT_HIGHLIGHT(_name, _color) \
    if (name : _name) {               \
        color = _color;               \
    }
#define COLOR3(_fg, _bg) \
    textColor = _fg;     \
    borderColor = _fg;   \
    backgroundColor = _bg;

#define HIDE_1(_name)                     \
    if (name : _name && quantity : < 2) { \
        hidden = true;                    \
    }
#define HIDE_LT_QUANTITY(_name, _qnt)        \
    if (name : _name && quantity : < _qnt) { \
        hidden = true;                       \
    }
#define HIDE_LT_VALUE(_name, _val)        \
    if (name : _name && value : < _val) { \
        hidden = true;                    \
    }
#define COLOR_GT_VALUE(_name, _val, _color) if (name:_name && value:>_val) { \
        color = _color;                                                      \
    }

#define UNIQUE_S_TIER(_name) \
    if (name : _name) {      \
        COLOR3(RED, WHITE)   \
        textAccent = 3;      \
        fontType = 2;        \
        showLootBeam = true; \
    }

#define UNIQUE_A_TIER(_name)       \
    if (name : _name) {            \
        COLOR_FG_BG(BLACK, PINK60) \
        showLootBeam = true;       \
        textAccent = 3;            \
        lootBeamColor = CHARCOAL;  \
    }
#define UNIQUE_B_TIER(_name)        \
    if (name : _name) {             \
        COLOR_FG_BG(BLACK, GREEN60) \
        textAccent = 3;             \
    }
#define UNIQUE_C_TIER(_name)       \
    if (name : _name) {            \
        COLOR_FG_BG(BLACK, BLUE60) \
        textAccent = 3;            \
    }

#define RARE_CUSTOM(_name, _color, _backgroundColor) \
    if (name : _name) {                              \
        COLOR_FG_BG(_color, _backgroundColor)        \
        showLootBeam = true;                         \
    }

#define S_TIER               \
    {                        \
        COLOR3(RED, WHITE)   \
        textAccent = 3;      \
        fontType = 2;        \
        showLootBeam = true; \
        lootbeamColor = RED; \
    }

#define A_TIER                                     \
    {                                              \
        COLOR_FG_BG_TXT(RED, PURPLE65, LIGHT_GRAY) \
        textAccent = 3;                            \
        fontType = 2;                              \
        showLootBeam = true;                       \
        lootBeamColor = PURPLE;                    \
    }
#define B_TIER                               \
    {                                        \
        COLOR_FG_BG_TXT(GOLD, GOLD65, BLACK) \
        showLootBeam = true;                 \
        lootBeamColor = GOLD;                \
    }
#define C_TIER                                      \
    {                                               \
        COLOR_FG_BG_TXT(GREEN, GREEN40, LIGHT_GRAY) \
        showLootBeam = true;                        \
    }
#define D_TIER                                    \
    {                                             \
        COLOR_FG_BG_TXT(BLUE, BLUE15, LIGHT_GRAY) \
        showLootBeam = false;                     \
    }

#define CURRENCIES    \
    {                 \
        color = GOLD; \
    }

#define DEFAULT_STYLE  \
    {                  \
        color = WHITE; \
    }

#define VALUE_S_TIER (_name) if (name : _name) S_TIER
#define VALUE_A_TIER (_name) if (name : _name) A_TIER
#define VALUE_B_TIER (_name) if (name : _name) B_TIER
#define VALUE_C_TIER (_name) if (name : _name) C_TIER
#define VALUE_D_TIER (_name) if (name : _name) D_TIER

#define CURRENCY (_name) if (name : _name) CURRENCIES

#define MASTER_CLUES(_name)             \
    if (name : _name) {                 \
        CLUE_COLOR(MASTER_RED, KHAKI65) \
    }
#define ELITE_CLUES(_name)            \
    if (name : _name) {               \
        CLUE_COLOR("cdb100", KHAKI65) \
    }
#define HARD_CLUES(_name)               \
    if (name : _name) {                 \
        CLUE_COLOR("ff833798", KHAKI65) \
    }
#define MEDIUM_CLUES(_name)             \
    if (name : _name) {                 \
        CLUE_COLOR("ff569699", KHAKI65) \
    }
#define EASY_CLUES(_name)               \
    if (name : _name) {                 \
        CLUE_COLOR(DARK_GREEN, KHAKI65) \
    }
#define BEGINNER_CLUES(_name)      \
    if (name : _name) {            \
        CLUE_COLOR(WHITE, KHAKI65) \
    }

// Clues
MASTER_CLUES("clue scroll (master)")
